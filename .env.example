# Product Order Orchestrator configuration.
# Copy to .env (`cp .env.example .env`) and fill in the three required values.
# The node scripts (start, start:all, doctor, dashboard, smoke:shop, agent:*) load .env automatically
# (node --env-file-if-exists=.env); the bash helpers (browser:chrome, clawmetry, clawmetry:setup)
# do not. Variables already set in your shell win over this file.
# Optional settings are commented out and show their default; uncomment to change.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Anthropic API key used by all four agents (https://console.anthropic.com/settings/keys).
ANTHROPIC_API_KEY=

# Token of YOUR Telegram bot, from @BotFather (/newbot). Keep it secret.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id: the only account the bot talks to.
# Leave empty on first start: the bot then runs in setup mode and replies to /start with your id.
TELEGRAM_ALLOWED_USER_ID=

# Optional: another Bot API server (a local one, or a fake one in tests). Empty = https://api.telegram.org
# TELEGRAM_API_ROOT=

# ---------------------------------------------------------------------------
# Models and effort (Claude Agent SDK)
# ---------------------------------------------------------------------------

# COS_MODEL=claude-opus-5-5
# EXPLORE_MODEL=claude-sonnet-5-5
# EXECUTE_MODEL=claude-sonnet-5-5
# QA_MODEL=claude-sonnet-5-5
# One of: low, medium, high, xhigh, max
# AGENT_EFFORT=medium

# ---------------------------------------------------------------------------
# Spending limits, in USD
# ---------------------------------------------------------------------------

# Per sub-agent task: the task stops when it reaches its budget and reports BUDGET_EXCEEDED to COS.
# EXPLORE_MAX_BUDGET_USD=0.5
# EXECUTE_MAX_BUDGET_USD=3
# QA_MAX_BUDGET_USD=1.5
# Per COS model session, not a cap on total spend: past 60% of it COS starts a fresh session between
# messages (order facts carry over), and a session that reaches it mid-step is replaced and continues the step.
# COS_MAX_BUDGET_USD=2

# ---------------------------------------------------------------------------
# A2A sub-agents (local HTTP servers started by COS)
# ---------------------------------------------------------------------------

# 127.0.0.1 or localhost only: the A2A servers and the dashboard have no authentication.
# A2A_HOST=127.0.0.1
# EXPLORE_PORT=41001
# EXECUTE_PORT=41002
# QA_PORT=41003
# 1 = start all sub-agents together with COS instead of on first use (`pnpm start:all` sets it).
# SUBAGENTS_PRESTART=0
# Longest time COS waits for one sub-agent turn, in ms (30 minutes).
# SUBAGENT_TIMEOUT_MS=1800000

# ---------------------------------------------------------------------------
# Browser (Execute and QA fill the basket in your own Chrome profile)
# ---------------------------------------------------------------------------

# extension: your Chrome profile through the Playwright MCP Bridge extension (no debugging port).
# cdp: a dedicated Chrome profile with remote debugging (`pnpm browser:chrome`); the basket then lives there.
# BROWSER_MODE=extension
# Extension mode: the Chrome profile folder with the extension (chrome://version → Profile Path ends with it).
# CHROME_PROFILE_DIR=Default
# Extension mode: the token the extension shows (click its icon). Empty = Chrome asks you to approve every run.
# Keep it secret: whoever has it can drive this Chrome profile.
# PLAYWRIGHT_MCP_EXTENSION_TOKEN=
# CDP mode: the endpoint (`pnpm browser:chrome` listens on 9333; CHROME_DEBUG_PORT=<port> in the shell moves it).
# BROWSER_CDP_URL=http://127.0.0.1:9333
# Browser tool server per agent: playwright, or agent-browser (BROWSER_MODE=cdp only)
# EXECUTE_BROWSER_MCP=playwright
# QA_BROWSER_MCP=playwright

# ---------------------------------------------------------------------------
# Shop
# ---------------------------------------------------------------------------

# DEFAULT_SHOP=karashynyard

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Built-in live dashboard (http://127.0.0.1:41010). DASHBOARD_ENABLED=0 stops agents sending events to it.
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=41010
# DASHBOARD_ENABLED=1

# OpenTelemetry traces (OTLP/HTTP) go to ClawMetry. Set it empty to turn tracing off.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:8900
# ClawMetry web UI (used for links and by `pnpm run doctor`).
# CLAWMETRY_URL=http://127.0.0.1:8900
# `pnpm clawmetry` listens on CLAWMETRY_HOST:CLAWMETRY_PORT, read from the shell (not from this file). If you
# move it, set the same port in CLAWMETRY_URL and OTEL_EXPORTER_OTLP_ENDPOINT above.
# CLAWMETRY_HOST=127.0.0.1
# CLAWMETRY_PORT=8900

# ---------------------------------------------------------------------------
# Logs and runtime files
# ---------------------------------------------------------------------------

# One of: fatal, error, warn, info, debug, trace, silent
# LOG_LEVEL=info
# Sessions, logs, event journal and browser artifacts (relative to the project folder).
# RUNTIME_DIR=.runtime
# Dashboard journal days and browser run folders older than this many days are deleted on start (0 keeps all).
# RUNTIME_RETENTION_DAYS=14
