# OpenClaw's postinstall rewrites its own package folder. With pnpm's side-effects cache, a later `pnpm install`
# restores that cached copy without OpenClaw's bundled dependencies (@openclaw/proxyline), and `pnpm start` fails with
# "Cannot find package '@openclaw/proxyline'". Without the cache, every install runs the postinstall on a clean copy.
side-effects-cache=false
