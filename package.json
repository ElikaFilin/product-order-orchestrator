{
  "name": "product-order-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "OpenClaw agents (COS, Explore, Execute, QA) that fill an online-shop basket in your own browser, driven from Telegram.",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "start": "pnpm plugin:build && pnpm openclaw:config && pnpm openclaw gateway run",
    "openclaw": "node --env-file-if-exists=.env --import tsx src/cli/openclaw.ts",
    "dashboard": "pnpm openclaw dashboard",
    "doctor": "node --env-file-if-exists=.env --import tsx src/cli/doctor.ts",
    "smoke:shop": "node --env-file-if-exists=.env --import tsx src/cli/shop-smoke.ts",
    "browser:chrome": "bash scripts/chrome-profile.sh",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "plugin:build": "node scripts/build-plugin.mjs",
    "openclaw:config": "node --env-file-if-exists=.env --import tsx src/cli/openclaw-config.ts",
    "test:e2e": "node --import tsx test/e2e/run.e2e.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/mcp": "0.0.83",
    "tsx": "4.23.15",
    "typebox": "1.3.34",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "openclaw": "2026.9.9",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "openclaw"
    ]
  }
}
